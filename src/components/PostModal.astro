<dialog class="post-modal" id="post-modal" aria-label="文章详情">
	<div class="post-modal-bar">
		<button class="post-modal-close" type="button" data-post-modal-close aria-label="关闭">
			<svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
				<path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"
				></path>
			</svg>
		</button>
	</div>
	<div class="post-modal-loading" data-post-modal-loading hidden>
		<span class="feed-sentinel-bar"></span>
		<span>加载中…</span>
	</div>
	<div class="post-modal-body article" data-post-modal-body></div>
</dialog>
