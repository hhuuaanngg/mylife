---
import { formatDate } from '../lib/site';
import type { Post } from '../lib/posts';

interface Props {
	post: Post;
}

const { post } = Astro.props;
const { title, date, tags, photos } = post.data;
const shownCount = Math.min(photos.length, 9);
const extra = photos.length - 9;
---

<article class="post" id={post.id} data-post-id={post.id}>
	{
		photos.length > 0 && (
			<div class="photo-grid" data-count={shownCount}>
				{photos.map((src, index) => (
					<button
						class="photo-cell"
						type="button"
						data-lightbox
						data-post={post.id}
						data-index={index}
						aria-label={`查看「${title}」第 ${index + 1} 张`}
					>
						<img src={src} alt={`${title} ${index + 1}`} loading="lazy" />
						{index === 8 && extra > 0 && <span class="photo-overflow">+{extra}</span>}
					</button>
				))}
			</div>
		)
	}
	<div class="post-body">
		<div class="post-text" data-expand>
			<slot />
		</div>
		<button class="more-btn" type="button" data-more hidden>更多</button>
	</div>
	<footer class="post-foot">
		<time datetime={date.toISOString()}>{formatDate(date)}</time>
		<div class="tags">
			{
				tags.map((tag) => (
					<a class="tag" href={`/t/${encodeURIComponent(tag)}`}>
						#{tag}
					</a>
				))
			}
		</div>
		<button class="like-btn" type="button" data-like={post.id} aria-label="喜欢" aria-pressed="false">
			<svg viewBox="0 0 24 24" aria-hidden="true">
				<path
					class="heart-outline"
					fill="none"
					stroke="currentColor"
					stroke-width="1.7"
					stroke-linejoin="round"
					d="M12.1 20.3s-6.8-4.3-9.2-8.1C1.2 9.4 2 6.2 5 5.1c1.9-.7 3.9.1 5.1 1.7 1.2-1.6 3.2-2.4 5.1-1.7 3 1.1 3.8 4.3 2.1 7.1-2.4 3.8-9.2 8.1-9.2 8.1Z"
				></path>
				<path
					class="heart-fill"
					fill="currentColor"
					d="M12.1 20.3s-6.8-4.3-9.2-8.1C1.2 9.4 2 6.2 5 5.1c1.9-.7 3.9.1 5.1 1.7 1.2-1.6 3.2-2.4 5.1-1.7 3 1.1 3.8 4.3 2.1 7.1-2.4 3.8-9.2 8.1-9.2 8.1Z"
				></path>
			</svg>
		</button>
	</footer>
</article>
