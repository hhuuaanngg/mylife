---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostFeed from '../../components/PostFeed.astro';
import Pager from '../../components/Pager.astro';
import { getPosts, paginate } from '../../lib/posts';
import { site } from '../../lib/site';

export async function getStaticPaths() {
	const posts = await getPosts();
	const { totalPages } = paginate(posts, 1);
	return Array.from({ length: Math.max(0, totalPages - 1) }, (_, i) => ({
		params: { page: String(i + 2) },
	}));
}

const pageNum = Number(Astro.params.page);
const all = await getPosts();
const { items, page, totalPages, total } = paginate(all, pageNum);
---

<BaseLayout title={`第 ${page} 页`} current="home">
	<main class="wrap">
		<div class="page-kicker">
			<h1>{site.name}</h1>
			<p>
				{total} 篇 · 第 {page} 页
			</p>
		</div>
		<PostFeed posts={items} />
		<Pager page={page} totalPages={totalPages} />
	</main>
</BaseLayout>
